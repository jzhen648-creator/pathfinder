# Copy to .env and fill in values. Never commit real secrets.

DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3001"
# Required. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
# Optional — AI features. https://console.groq.com/keys
GROQ_API_KEY=""
NEXT_PUBLIC_DEV_MODE=true

# Optional override (see .env.local)
# NEXT_PUBLIC_USE_MOCK_DATA=false

# Tree: moment markers + roadmap goal nodes on threads (default on). Add-goal tip glow is always on.
# NEXT_PUBLIC_TREE_THREAD_MARKER_VISUALS=0

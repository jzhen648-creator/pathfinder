# Copy to .env.local — never commit secrets.

# Database (Supabase). Use pooler URL for app; DIRECT_URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Auth (must match deployed NEXTAUTH_URL on Vercel)
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="generate-a-long-random-string"

# AI
GEMINI_API_KEY=""
# Free-tier QA: higher RPM/RPD than 2.5 Flash — optional, defaults to gemini-2.5-flash
# GEMINI_MODEL="gemini-2.5-flash-lite"

# Reflect sync — one Update tap → Reading + all pursuit panels (1 Gemini call).
# Must be exactly "true" on Vercel Production (empty value = legacy path, up to 2 calls).
USE_REFLECT_CALL="true"

# QA: bypass 2h reading delivery gate on manual Update taps.
AI_READING_DELIVERY_BYPASS="true"

# Source-to-Life import processing. Keep off until the review UI is ready.
# AI_FAKE_PROVIDER=1 enables deterministic local/CI processing without this flag.
IMPORT_PROCESSING_ENABLED="0"

# Vercel Cron (set in Vercel dashboard — Production + Preview if crons enabled)
# CRON_SECRET="generate-a-long-random-string"

# Smoke test / CI (GitHub Actions secrets: SMOKE_EMAIL, SMOKE_PASSWORD)
# SMOKE_BASE_URL="https://pathfinder-xi-rust.vercel.app"
# SMOKE_EMAIL=""
# SMOKE_PASSWORD=""

# Copy to .env.local — never commit secrets.

# Database (Supabase). Use pooler URL for app; DIRECT_URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Auth (must match deployed NEXTAUTH_URL on Vercel)
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="generate-a-long-random-string"

# AI
GEMINI_API_KEY=""

# Vercel Cron (set in Vercel dashboard — Production + Preview if crons enabled)
# CRON_SECRET="generate-a-long-random-string"

# Smoke test / CI (GitHub Actions secrets: SMOKE_EMAIL, SMOKE_PASSWORD)
# SMOKE_BASE_URL="https://pathfinder-xi-rust.vercel.app"
# SMOKE_EMAIL=""
# SMOKE_PASSWORD=""

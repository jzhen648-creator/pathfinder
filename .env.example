# Copy to .env and fill in values. Never commit real secrets.

DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3001"
# Required. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
# Optional — AI features. Supported: gemini (default), groq, deepseek.
AI_PROVIDER="gemini"
# Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
# Groq: https://console.groq.com/keys
GROQ_API_KEY=""
# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=""
NEXT_PUBLIC_DEV_MODE=true
# Optional — account used by the Dev login button on /login
# NEXT_PUBLIC_DEV_PIN_USER_EMAIL="jzhen648@gmail.com"

# Tree: moment markers + roadmap goal nodes on threads (default on). Add-goal tip glow is always on.
# NEXT_PUBLIC_TREE_THREAD_MARKER_VISUALS=0

# Tree: sequence-driven branch line (goals + marks along one ray; branch grows with node count).
# Set to 1 or true to enable. Omit or use 0 / false for legacy domain-cluster goal orbit per theme.
# NEXT_PUBLIC_BRANCH_LONGITUDINAL_ALL=1

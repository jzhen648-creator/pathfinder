generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                @id @default(cuid())
  name                    String?
  birthYear               Int?
  birthPlace              String?
  email                   String                @unique
  passwordHash            String
  passwordResetToken      String?               @unique
  passwordResetExpiry     DateTime?
  onboardingCompleted     Boolean               @default(false)
  /// Theme picked during guided onboarding Scene 2 (`LifeAreaId` / limb id).
  onboardingThemeId       String?
  /// Last applied {@link TAXONOMY_VERSION} from taxonomy-sync; null = never synced.
  taxonomyVersion         String?
  taxonomySyncedAt        DateTime?
  /// Last successful AI reading delivery (Gemini-bearing ai-sync); free-tier interval gate.
  lastReadingDeliveredAt  DateTime?
  /// Last successful full-map reflect (theme synthesis + all pursuits); periodic regen gate.
  lastFullReflectAt       DateTime?
  /// Life-area ids unlocked on the tree (`finance` | `work` | …).
  unlockedLimbIds         Json?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  goals                   Goal[]
  branches                ThemeCategory[]
  accounts                Account[]
  sessions                Session[]
  profileFacts            ProfileFact[]
  manualProfile           UserManualProfile?
  insightCache            InsightCache?
  readingDirtyItems       AiReadingDirtyItem[]
  userMemory              UserMemory?
  userMemoryHistory       UserMemoryHistory[]
  pursuitContextEntries   PursuitContextEntry[]
  pursuitRelationships    PursuitRelationship[]
  betaUsageEvents         BetaUsageEvent[]
}

/// Friends-and-family TestFlight usage telemetry (client + server auth events).
model BetaUsageEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  props     Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([name, createdAt])
}

/// Pursuit (`Goal`) lifecycle + reused on `ThemeCategory` / timeline derivation.
enum PursuitStatus {
  ACTIVE
  PAUSED
  COMPLETE
  MAINTAINING
}

enum BranchStatus {
  active
  paused
  achieved
  abandoned
}

enum ProfileFactCategory {
  personal
  career
  financial
  health
  relationships
  preferences
  strengths
}

enum ProfileFactSource {
  user_manual
}

enum AiReadingDirtyEntityType {
  pursuit
  theme
  global
}

enum PursuitContextEntryKind {
  clarifier_answer
  manual_edit
  create
  ai_merge
}

enum PursuitRelationshipKind {
  related
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ThemeCategory {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Life area id (`finance` | `work` | `becoming` | `people` | `health` | `pleasures`).
  themeId          String
  label            String?
  mapAngleOffset   Float          @default(0)
  goals            Goal[]
  status           BranchStatus   @default(active)
  order            Int            @default(0)
  /// Progressive reveal: visible on tree/roadmap when true.
  isActive         Boolean        @default(false)
  /// Locked taxonomy category (one of 22); protected from wipe scripts.
  isSystemCategory Boolean        @default(false)
  lifecycleStatus  PursuitStatus  @default(ACTIVE)
  completedAt      DateTime?
  endedAt          DateTime?
  endReason        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId])
  @@index([userId, themeId])
  @@index([userId, isActive])
}

model ProfileFact {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   ProfileFactCategory
  key        String
  value      String
  confidence Float?
  source     ProfileFactSource   @default(user_manual)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([userId, category, key])
  @@index([userId, category])
}

model UserManualProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName      String?
  dateOfBirth      DateTime?
  location         String?
  languages        String[]
  occupation       String?
  educationLevel   String?
  employmentStatus String?
  industry         String?
  jobTitle         String?
  /// ISO 4217 currency code for formatting finance amounts (e.g. GBP, USD, EUR).
  currencyCode     String?
  /// metric | imperial — display preference for weight/distance metrics.
  measurementSystem String?
  updatedAt        DateTime  @updatedAt
  createdAt        DateTime  @default(now())
}

/// AI-observed personal context (WHO). Separate from map data (WHAT).
model UserMemory {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Structured prose summary (~250 words) for formatUserContext.
  blob             String    @db.Text
  version          Int       @default(1)
  isDirty          Boolean   @default(false)
  lastUserEditedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
}

model UserMemoryHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blob      String   @db.Text
  version   Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Cached AI insights for Reading tab + theme/pursuit detail panels.
model InsightCache {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  globalInsight   String   @db.Text
  themeInsights     Json
  /// Category-tier insight JSON. SQL column retains legacy name until optional tail rename.
  categoryInsights  Json     @map("hubInsights")
  pursuitInsights   Json
  /// AI-authored whole-map reading hero (oneLiner + support) for Reading tab OVERALL card.
  overallInsight    Json?
  generatedAt     DateTime @default(now())
  /// Hash of pursuit/milestone counts + latest updatedAt; invalidates cache when map changes.
  mapVersion      String
  /// From UserMemory.version when Phase B exists; 0 until then.
  memoryVersion   Int      @default(0)
  updatedAt       DateTime @updatedAt
}

/// Tracks map entities that changed since the last successful AI reading sync.
model AiReadingDirtyItem {
  id         String                   @id @default(cuid())
  userId     String
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType AiReadingDirtyEntityType
  entityId   String
  reason     String
  details    Json?
  createdAt  DateTime                 @default(now())

  @@unique([userId, entityType, entityId])
  @@index([userId, createdAt])
}

model Goal {
  id                String        @id @default(cuid())
  title             String
  /// AI-generated compact label for map canvas SVG only (never panel/roadmap/timeline).
  shortLabel        String?
  /// Lucide kebab-case slug for pursuit hex icon (e.g. "dumbbell"). Null → theme icon at render.
  iconName          String?
  description       String
  /// User-authored background prose — AI reads, never writes. Physical column rename deferred post-TestFlight.
  background        String?  @map("rationale")
  /// Structured clarifier answers from pursuit enrich ({ clarifierId, prompt, selectedOption }[]).
  enrichAnswers     Json?
  lifeArea          String        @default("Other")
  goalType          String        @default("action")
  targetAmount      Float?
  currentAmount     Float?
  unit              String?
  /// gross | net — how currentAmount should be read (flow income pursuits).
  amountBasis       String?
  deadline          DateTime?
  /// Swimlane / timeline span start; when null the UI uses {@link createdAt}.
  timelineStart     DateTime?
  aiGenerated       Boolean       @default(true)
  archived          Boolean       @default(false)
  status            PursuitStatus @default(ACTIVE)
  completedAt       DateTime?
  endedAt           DateTime?
  endReason         String?
  parentGoalId      String?
  parentGoal        Goal?         @relation("GoalFork", fields: [parentGoalId], references: [id], onDelete: SetNull)
  forkedGoals       Goal[]        @relation("GoalFork")
  createdFromGoalId String?
  createdFromGoal   Goal?         @relation("SuggestAddProvenance", fields: [createdFromGoalId], references: [id], onDelete: SetNull)
  suggestedGoals    Goal[]        @relation("SuggestAddProvenance")
  year              Int           @default(2026)
  month             Int?
  /// Explicit linear order along the parent category line (mobile reorganize fallback).
  sequencePosition  Float?
  /// Mobile map world-grid axial q — when set, layout pins this pursuit to the cell.
  mapGridQ          Int?
  /// Mobile map world-grid axial r — when set, layout pins this pursuit to the cell.
  mapGridR          Int?
  /// User-set importance 1–5; null = unset (map renders neutral size).
  significance      Int?
  future            Boolean       @default(false)
  isTurningPoint    Boolean       @default(false)
  location          String?
  timelineNote      String?
  subtype           String?
  themeId           String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId        String?
  themeCategory     ThemeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  milestones        Milestone[]
  contextEntries    PursuitContextEntry[]
  relationshipsAsA  PursuitRelationship[] @relation("RelationshipGoalA")
  relationshipsAsB  PursuitRelationship[] @relation("RelationshipGoalB")

  @@index([parentGoalId])
  @@index([createdFromGoalId])
  @@index([categoryId])
  @@index([themeId])
  @@index([archived])
  @@index([categoryId, sequencePosition])
}

/// Append-only pursuit context log — source of truth for user-stated context.
model PursuitContextEntry {
  id        String                  @id @default(cuid())
  userId    String
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId    String
  goal      Goal                    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  kind      PursuitContextEntryKind
  text      String
  metadata  Json?
  createdAt DateTime                @default(now())

  @@index([goalId, createdAt])
  @@index([userId, createdAt])
}

/// User-confirmed lateral relationship between two pursuits (peers, not trees).
model PursuitRelationship {
  id                String                  @id @default(cuid())
  userId            String
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalAId           String
  goalA             Goal                    @relation("RelationshipGoalA", fields: [goalAId], references: [id], onDelete: Cascade)
  goalBId           String
  goalB             Goal                    @relation("RelationshipGoalB", fields: [goalBId], references: [id], onDelete: Cascade)
  kind              PursuitRelationshipKind @default(related)
  label             String?
  sourceClarifierId String?
  confirmedAt       DateTime                @default(now())
  createdAt         DateTime                @default(now())

  @@unique([userId, goalAId, goalBId])
  @@index([userId])
  @@index([goalAId])
  @@index([goalBId])
}

model Milestone {
  id          String    @id @default(cuid())
  title       String
  description String
  position    Int
  completedAt DateTime?
  goalId      String
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, position])
}

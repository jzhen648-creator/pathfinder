generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                         String                @id @default(cuid())
  name                       String?
  birthYear                  Int?
  birthPlace                 String?
  email                      String                @unique
  passwordHash               String
  passwordResetToken         String?               @unique
  passwordResetExpiry        DateTime?
  onboardingCompleted        Boolean               @default(false)
  /// Six-scene guided onboarding progress; null = not started.
  onboardingScene            Int?
  /// Theme picked during guided onboarding Scene 2 (`LifeAreaId` / limb id).
  onboardingThemeId          String?
  /// Hub picked during guided onboarding Scene 3 (normalized label slug).
  onboardingHubSlug          String?
  /// First theme picked during onboarding (selection order); drives first-run Stream prompt.
  onboardingPrimaryLimbId    String?
  /// Post-onboarding welcome + first Stream commit; one-time.
  firstRunCompleted          Boolean               @default(false)
  onboardingProfileText      String?
  onboardingProfileData      Json?
  careerEducationContextText String?
  lifeWheelRatings           Json?
  lifeWheelHistory           Json?
  lifeWheelAchievementAt     DateTime?
  /// Last applied {@link TAXONOMY_VERSION} from taxonomy-sync; null = never synced.
  taxonomyVersion            String?
  taxonomySyncedAt           DateTime?
  /// Life-area ids unlocked on the tree (`finance` | `work` | …). Hubs under a theme stay dormant until opened individually.
  unlockedLimbIds            Json?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  goals                      Goal[]
  branches                   ThemeCategory[]
  marks                      Mark[]
  evaluationCaches           GoalEvaluationCache[]
  accounts                   Account[]
  sessions                   Session[]
  trunkSegments              TrunkSegment[]
  trunkEntries               TrunkEntry[]
  streamSessions             StreamSession[]
  streamRuns                 StreamRun[]
  profileFacts               ProfileFact[]
  manualProfile              UserManualProfile?
  insightCache               InsightCache?
  storyCache                 StoryCache?
  userMemory                 UserMemory?
  userMemoryHistory          UserMemoryHistory[]
}

/// Goal (`Goal`) lifecycle + reused on `Branch` / timeline derivation.
enum BloomStatus {
  ACTIVE
  PAUSED
  COMPLETE
  MAINTAINING
  ABANDONED
}

enum BranchStatus {
  active
  paused
  achieved
  abandoned
}

enum MarkSentiment {
  positive
  neutral
  negative
}

enum TrunkCategory {
  FAMILY
  EDUCATION
  CULTURE_RELIGION
  SOCIOECONOMIC
  EARLY_HEALTH
  FORMATIVE
  PLACE
}

enum TrunkEntrySource {
  MANUAL
  VOICE
  DOCUMENT
  AI_EXTRACTED
}

enum StreamInputMode {
  text
  voice
}

enum ProfileFactCategory {
  personal
  career
  financial
  health
  relationships
  preferences
  strengths
}

enum ProfileFactSource {
  stream_extracted
  user_manual
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ThemeCategory {
  id                  String       @id @default(cuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Life area id (`finance` | `work` | `becoming` | `people` | `health` | `pleasures`).
  themeId             String
  label               String?
  parentCategoryId    String?
  turningPointId      String?
  mapAngleOffset      Float        @default(0)
  marks               Mark[]
  goals               Goal[]
  name                String?
  goal                String?
  goalValue           Float?
  currentValue        Float?
  unit                String?
  status              BranchStatus @default(active)
  order               Int          @default(0)
  /// Progressive reveal: visible on tree/roadmap when true.
  isActive            Boolean      @default(false)
  /// Locked taxonomy category (one of 22); protected from wipe scripts.
  isSystemCategory    Boolean      @default(false)
  lifecycleStatus     BloomStatus  @default(ACTIVE)
  bloomedAt           DateTime?
  endedAt             DateTime?
  endReason           String?
  spawnedFromCategoryId String?
  spawnedFromCategory ThemeCategory? @relation("CategorySpawn", fields: [spawnedFromCategoryId], references: [id], onDelete: SetNull)
  categoriesSpawnedHere ThemeCategory[] @relation("CategorySpawn")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([userId])
  @@index([userId, themeId])
  @@index([userId, isActive])
}

model Mark {
  id                String        @id @default(cuid())
  categoryId        String
  themeCategory     ThemeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Life area id — same values as {@link ThemeCategory.themeId}.
  themeId           String
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  date              DateTime?
  value             Float?
  sentiment         MarkSentiment @default(neutral)
  archived          Boolean       @default(false)
  significance      Int           @default(1)
  future            Boolean       @default(false)
  isTurningPoint    Boolean       @default(false)
  parentMarkId      String?
  parentMark        Mark?         @relation("MarkChildren", fields: [parentMarkId], references: [id], onDelete: SetNull)
  children          Mark[]        @relation("MarkChildren")
  location          String?
  timelineNote      String?
  subtype           String?
  year              Int?
  month             Int?
  /// Explicit linear order along the parent hub's branch line. Co-sorted with `Goal.sequencePosition`
  /// (same branch) to form the `sequencedNodes` list. Fractional to support midpoint inserts;
  /// branches are reindexed when minimum sibling gap drops below the resolver epsilon.
  sequencePosition  Float?
  /// Origin of this mark — `mark` (user/manual or legacy), `stream` (AI Stream-produced moment).
  kind              String        @default("mark")
  /// Stream ambiguous item placed on tree before user picks Done / In progress / Not started.
  needsResolution   Boolean       @default(false)
  /// Stable id from Stream extract `ambiguous[].id` (dedup on re-extract).
  streamAmbiguousId String?
  /// Pursuit Stream apply run that created this mark (for undo/review).
  sourceStreamRunId String?
  sourceStreamRun   StreamRun?    @relation(fields: [sourceStreamRunId], references: [id], onDelete: SetNull)
  reframes          Reframe[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([categoryId])
  @@index([sourceStreamRunId])
  @@index([themeId])
  @@index([archived])
  @@index([date])
  @@index([parentMarkId])
  @@index([categoryId, sequencePosition])
}

model Reframe {
  id        String   @id @default(cuid())
  markId    String
  mark      Mark     @relation(fields: [markId], references: [id], onDelete: Cascade)
  note      String
  date      DateTime
  createdAt DateTime @default(now())

  @@index([markId])
  @@index([date])
}

/// Theme-level Stream session — raw brain dump after commit for cross-session dedup.
model StreamSession {
  id                    String          @id @default(cuid())
  userId                String
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Life area id — same as themeId on map entities.
  themeId               String
  inputText             String
  inputMode             StreamInputMode
  itemsAdded            Int
  itemsSkipped          Int
  summaryJson           Json?
  processedForProfile   Boolean         @default(false)
  processedForProfileAt DateTime?
  createdAt             DateTime        @default(now())

  @@index([userId, themeId, createdAt])
  @@index([userId, processedForProfile, createdAt])
}

enum StreamRunStatus {
  pending
  applied
  failed
  undone
}

/// One pursuit-scoped Stream submission — raw input, applied items, undo metadata.
model StreamRun {
  id                  String          @id @default(cuid())
  userId              String
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId              String
  categoryId          String
  themeId             String
  rawInput            String          @db.Text
  inputMode           StreamInputMode @default(text)
  status              StreamRunStatus @default(pending)
  /// Goal.description before this run (for revert).
  previousDescription String?         @db.Text
  /// Goal.bloomStatus before this run (for revert).
  previousBloomStatus BloomStatus?
  summaryJson         Json?
  expiresAt           DateTime
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  marks               Mark[]
  milestones          Milestone[]

  @@index([userId, goalId, createdAt])
  @@index([userId, expiresAt])
}

model ProfileFact {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   ProfileFactCategory
  key        String
  value      String
  confidence Float?
  source     ProfileFactSource   @default(stream_extracted)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([userId, category, key])
  @@index([userId, category])
}

model UserManualProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String?
  dateOfBirth DateTime?
  location    String?
  languages   String[]
  occupation  String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

/// AI-observed personal context (WHO). Separate from map data (WHAT).
model UserMemory {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Structured prose summary (~250 words) for formatUserContext.
  blob               String   @db.Text
  version            Int      @default(1)
  isDirty            Boolean  @default(false)
  lastUserEditedAt   DateTime?
  streamSessionCount Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}

model UserMemoryHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blob      String   @db.Text
  version   Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Cached AI insights for Now tab + theme/hub/pursuit sparkle buttons (Session 11).
model InsightCache {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  globalInsight   String   @db.Text
  themeInsights   Json
  hubInsights     Json
  pursuitInsights Json
  generatedAt     DateTime @default(now())
  /// Hash of pursuit/milestone/mark counts + latest updatedAt; invalidates cache when map changes.
  mapVersion      String
  /// From UserMemory.version when Phase B exists; 0 until then.
  memoryVersion   Int      @default(0)
  updatedAt       DateTime @updatedAt
}

/// Cached AI Story — personal coach narrative (on-demand, richer than Now tab insights).
model StoryCache {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payload       String   @db.Text
  generatedAt   DateTime @default(now())
  mapVersion    String
  memoryVersion Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model Goal {
  id               String      @id @default(cuid())
  title            String
  /// AI-generated compact label for tree canvas SVG only (never panel/roadmap/timeline).
  shortLabel       String?
  /// Lucide kebab-case slug for pursuit hex icon (e.g. "dumbbell"). Null → theme icon at render.
  iconName         String?
  description      String
  lifeArea         String      @default("Other")
  goalType         String      @default("action")
  targetAmount     Float?
  currentAmount    Float?
  /**
   * Unit label when using measurable targets (e.g. "kg", "sessions").
   */
  unit             String?
  /**
   * Optional: timeline/event goals and ongoing commitments may have no deadline.
   */
  deadline         DateTime?
  /// Swimlane / timeline span start; when null the UI uses {@link createdAt}.
  timelineStart    DateTime?
  // Cached raw roadmap returned by the AI model at creation time. Kept for
  // provenance + to avoid any future re-generation calls for the same goal.
  roadmapJson      Json?
  // False when the roadmap was produced by the deterministic fallback
  // because the AI provider failed or ran out of credits. UI can surface this.
  aiGenerated      Boolean     @default(true)
  /// Soft-removed from tree / timeline; hidden from map. Revive via PATCH `archived: false`.
  archived         Boolean     @default(false)
  /// Lifecycle maturity only (**BUD** / **GROWING** **BLOOMED** / **ENDED**). Not driven by continuation count; **`BRANCHED`** is legacy on goals.
  status           BloomStatus @default(ACTIVE)
  bloomedAt        DateTime?
  endedAt          DateTime?
  endReason        String?
  /// Predecessor goal when this goal is a **continuation** (evolved from / next chapter). Not a subgoal hierarchy; multiple rows may share one parent.
  parentGoalId     String?
  parentGoal       Goal?       @relation("GoalFork", fields: [parentGoalId], references: [id], onDelete: SetNull)
  /// Successor goals (**continuations**). Relation name is legacy (`GoalFork`); semantics are longitudinal evolution, not nesting.
  forkedGoals      Goal[]      @relation("GoalFork")
  positionAngle    Float?
  year             Int         @default(2026)
  month            Int?
  mapPosition      Float       @default(0)
  /// Explicit linear order along the parent hub's branch line. Co-sorted with `Mark.sequencePosition`
  /// (same branch) to form the `sequencedNodes` list. Roadmap-root goals only; evolution children
  /// (`parentGoalId != null`) keep parent-anchored satellite layout and have no sequence position.
  sequencePosition Float?
  /// Mobile map world-grid axial q — when set, layout pins this pursuit to the cell.
  mapGridQ         Int?
  /// Mobile map world-grid axial r — when set, layout pins this pursuit to the cell.
  mapGridR         Int?
  significance     Int         @default(1)
  future           Boolean     @default(false)
  isTurningPoint   Boolean     @default(false)
  location         String?
  timelineNote     String?
  subtype          String?
  /// Life area id when set (denormalized from category row).
  themeId          String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId       String?
  themeCategory    ThemeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Last pursuit Stream run that updated this goal's context/status.
  sourceStreamRunId String?
  milestones       Milestone[]

  @@index([parentGoalId])
  @@index([sourceStreamRunId])
  @@index([categoryId])
  @@index([themeId])
  @@index([archived])
  @@index([categoryId, sequencePosition])
}

// Caches the AI-generated evaluation for a specific (user, goal-inputs) tuple
// so repeat submissions of the same draft inside the create-goal modal don't
// re-bill the LLM provider.
model GoalEvaluationCache {
  id         String   @id @default(cuid())
  userId     String
  inputHash  String
  evaluation String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, inputHash])
  @@index([userId])
}

model Milestone {
  id          String    @id @default(cuid())
  title       String
  description String
  position    Int
  /// Explicit symbolic completion (petal “done”). Subtasks remain optional supporting depth.
  completedAt DateTime?
  goalId      String
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  sourceStreamRunId String?
  sourceStreamRun   StreamRun? @relation(fields: [sourceStreamRunId], references: [id], onDelete: SetNull)
  subtasks    Subtask[]

  @@unique([goalId, position])
  @@index([sourceStreamRunId])
}

model Subtask {
  id          String       @id @default(cuid())
  title       String
  position    Int
  isCompleted Boolean      @default(false)
  completedAt DateTime?
  milestoneId String
  milestone   Milestone    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  dailyTasks  DailyTask[]
  checkpoints Checkpoint[]

  @@unique([milestoneId, position])
}

model DailyTask {
  id         String  @id @default(cuid())
  title      String
  position   Int
  quickWinId String
  quickWin   Subtask @relation(fields: [quickWinId], references: [id], onDelete: Cascade)

  @@unique([quickWinId, position])
}

model Checkpoint {
  id         String  @id @default(cuid())
  title      String
  position   Int
  quickWinId String
  quickWin   Subtask @relation(fields: [quickWinId], references: [id], onDelete: Cascade)

  @@unique([quickWinId, position])
}

model TrunkSegment {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    TrunkCategory
  entries     TrunkEntry[]
  richness    Int           @default(0)
  heightScore Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([userId, category])
  @@index([userId])
}

model TrunkEntry {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  trunkSegmentId String
  segment        TrunkSegment     @relation(fields: [trunkSegmentId], references: [id], onDelete: Cascade)
  content        String
  year           Int?
  significance   Int              @default(3)
  source         TrunkEntrySource @default(MANUAL)
  aiSummary      String?
  tags           Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([trunkSegmentId])
  @@index([userId])
}

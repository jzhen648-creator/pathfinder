generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                         String   @id @default(cuid())
  name                       String?
  birthYear                  Int?
  birthPlace                 String?
  email                      String   @unique
  passwordHash               String
  onboardingCompleted        Boolean  @default(false)
  onboardingProfileText      String?
  onboardingProfileData      Json?
  careerEducationContextText String?
  lifeWheelRatings           Json?
  lifeWheelHistory           Json?
  lifeWheelAchievementAt     DateTime?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  goals                      Goal[]
  branches                   Branch[]
  marks                      Mark[]
  evaluationCaches           GoalEvaluationCache[]
  accounts                   Account[]
  sessions                   Session[]
  trunkSegments              TrunkSegment[]
  trunkEntries               TrunkEntry[]
}

enum BloomStatus {
  BUD
  GROWING
  BLOOMED
  BRANCHED
  ENDED
}

enum BranchStatus {
  active
  paused
  achieved
  abandoned
}

enum MarkType {
  milestone
  setback
  realisation
  decision
  achievement
}

enum MarkSentiment {
  positive
  neutral
  negative
}

enum TrunkCategory {
  FAMILY
  EDUCATION
  CULTURE_RELIGION
  SOCIOECONOMIC
  EARLY_HEALTH
  FORMATIVE
  PLACE
}

enum TrunkEntrySource {
  MANUAL
  VOICE
  DOCUMENT
  AI_EXTRACTED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Branch {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Legacy column name: stores the **life area** id (`finance` | `work` | `becoming` | `people` | `health`), not a "limb" entity. Prefer the term *life area* in docs and UI.
  limbId         String
  label          String?
  parentBranchId String?
  turningPointId String?
  mapAngleOffset Float    @default(0)
  marks          Mark[]
  goals          Goal[]
  name           String?
  goal           String?
  goalValue      Float?
  currentValue   Float?
  unit           String?
  status         BranchStatus @default(active)
  order          Int      @default(0)
  bloomStatus         BloomStatus @default(BUD)
  bloomedAt           DateTime?
  endedAt             DateTime?
  endReason           String?
  spawnedFromBranchId String?
  spawnedFromBranch   Branch?   @relation("BranchSpawn", fields: [spawnedFromBranchId], references: [id], onDelete: SetNull)
  branchesSpawnedHere Branch[]  @relation("BranchSpawn")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([userId, limbId])
}

model Mark {
  id          String   @id @default(cuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  /// Legacy column name: stores the **life area** id. See `Branch.limbId`.
  limbId      String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  date        DateTime
  type        MarkType
  value       Float?
  sentiment   MarkSentiment @default(neutral)
  archived    Boolean  @default(false)
  significance    Int      @default(1)
  future          Boolean  @default(false)
  isTurningPoint  Boolean  @default(false)
  parentMarkId    String?
  parentMark      Mark?    @relation("MarkChildren", fields: [parentMarkId], references: [id], onDelete: SetNull)
  children        Mark[]   @relation("MarkChildren")
  location        String?
  timelineNote    String?
  subtype         String?
  year            Int?
  month           Int?
  reframes    Reframe[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([branchId])
  @@index([limbId])
  @@index([archived])
  @@index([date])
  @@index([parentMarkId])
}

model Reframe {
  id        String   @id @default(cuid())
  markId    String
  mark      Mark     @relation(fields: [markId], references: [id], onDelete: Cascade)
  note      String
  date      DateTime
  createdAt DateTime @default(now())

  @@index([markId])
  @@index([date])
}

model Goal {
  id          String      @id @default(cuid())
  title       String
  description String
  lifeArea    String      @default("Other")
  goalType    String      @default("action")
  targetAmount Float?
  currentAmount Float?
  /** Unit label when using measurable targets (e.g. "kg", "sessions"). */
  unit        String?
  /** Optional: timeline/event goals and ongoing commitments may have no deadline. */
  deadline    DateTime?
  // Cached raw roadmap returned by the AI model at creation time. Kept for
  // provenance + to avoid any future re-generation calls for the same goal.
  roadmapJson Json?
  // False when the roadmap was produced by the deterministic fallback
  // because the AI provider failed or ran out of credits. UI can surface this.
  aiGenerated Boolean     @default(true)
  bloomStatus    BloomStatus @default(BUD)
  bloomedAt      DateTime?
  endedAt        DateTime?
  endReason      String?
  /** Forked sub-goals and former Moment parent links share this relation. */
  parentGoalId   String?
  parentGoal     Goal?       @relation("GoalFork", fields: [parentGoalId], references: [id], onDelete: SetNull)
  forkedGoals    Goal[]      @relation("GoalFork")
  positionAngle  Float?
  year            Int        @default(2026)
  month           Int?
  mapPosition     Float      @default(0)
  significance    Int        @default(1)
  future          Boolean    @default(false)
  isTurningPoint  Boolean    @default(false)
  location        String?
  timelineNote    String?
  subtype         String?
  /// Legacy column name: stores the **life area** id when set. See `Branch.limbId`.
  limbId          String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  milestones  Milestone[]

  @@index([parentGoalId])
  @@index([branchId])
  @@index([limbId])
}

// Caches the AI-generated evaluation for a specific (user, goal-inputs) tuple
// so repeat submissions of the same draft inside the create-goal modal don't
// re-bill the LLM provider.
model GoalEvaluationCache {
  id         String   @id @default(cuid())
  userId     String
  inputHash  String
  evaluation String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, inputHash])
  @@index([userId])
}

model Milestone {
  id          String    @id @default(cuid())
  title       String
  description String
  position    Int
  goalId      String
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  subtasks    Subtask[]

  @@unique([goalId, position])
}

model Subtask {
  id          String    @id @default(cuid())
  title       String
  position    Int
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  dailyTasks  DailyTask[]
  checkpoints Checkpoint[]

  @@unique([milestoneId, position])
}

model DailyTask {
  id        String   @id @default(cuid())
  title     String
  position  Int
  quickWinId String
  quickWin  Subtask  @relation(fields: [quickWinId], references: [id], onDelete: Cascade)

  @@unique([quickWinId, position])
}

model Checkpoint {
  id         String  @id @default(cuid())
  title      String
  position   Int
  quickWinId String
  quickWin   Subtask @relation(fields: [quickWinId], references: [id], onDelete: Cascade)

  @@unique([quickWinId, position])
}

model TrunkSegment {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    TrunkCategory
  entries     TrunkEntry[]
  richness    Int            @default(0)
  heightScore Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([userId, category])
  @@index([userId])
}

model TrunkEntry {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  trunkSegmentId String
  segment        TrunkSegment      @relation(fields: [trunkSegmentId], references: [id], onDelete: Cascade)
  content        String
  year           Int?
  significance   Int               @default(3)
  source         TrunkEntrySource  @default(MANUAL)
  aiSummary      String?
  tags           Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([trunkSegmentId])
  @@index([userId])
}


generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                        String                      @id @default(cuid())
  name                      String?
  birthYear                 Int?
  birthPlace                String?
  email                     String                      @unique
  /// Null for silent anonymous accounts until claimed with email/password.
  passwordHash              String?
  /// Guest-first launch: device-minted account before email claim.
  isAnonymous               Boolean                     @default(false)
  passwordResetToken        String?                     @unique
  passwordResetExpiry       DateTime?
  onboardingCompleted       Boolean                     @default(false)
  /// Theme picked during guided onboarding Scene 2 (`LifeAreaId` / limb id).
  onboardingThemeId         String?
  /// Last applied {@link TAXONOMY_VERSION} from taxonomy-sync; null = never synced.
  taxonomyVersion           String?
  taxonomySyncedAt          DateTime?
  /// Last successful AI reading delivery (Gemini-bearing ai-sync); free-tier interval gate.
  lastReadingDeliveredAt    DateTime?
  /// Last successful full-map reflect (theme synthesis + all pursuits); periodic regen gate.
  lastFullReflectAt         DateTime?
  /// Life-area ids unlocked on the tree (`finance` | `work` | …).
  unlockedLimbIds           Json?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  goals                     Goal[]
  branches                  ThemeCategory[]
  accounts                  Account[]
  sessions                  Session[]
  profileFacts              ProfileFact[]
  manualProfile             UserManualProfile?
  insightCache              InsightCache?
  readingDirtyItems         AiReadingDirtyItem[]
  userMemory                UserMemory?
  userMemoryHistory         UserMemoryHistory[]
  pursuitContextEntries     PursuitContextEntry[]
  pursuitRelationships      PursuitRelationship[]
  betaUsageEvents           BetaUsageEvent[]
  importSources             ImportSource[]
  importCaptureReceipts     ImportCaptureReceipt[]
  lifeObservations          LifeObservation[]
  chapterObservations       ChapterObservation[]
  importProposals           ImportProposal[]
  proposalApplications      ImportProposalApplication[]
  chapterRevisions          ChapterRevision[]
  interpretationCorrections InterpretationCorrection[]
  livingTreeGroups          LivingTreeGroup[]
  atlasPlacements           AtlasPlacement[]
  almanacImports            AlmanacImport[]
  almanacPlaces             AlmanacPlace[]
  almanacUpdates            AlmanacUpdate[]
  almanacSubjectPreferences AlmanacSubjectPreference[]
  almanacUpdatePreferences  AlmanacUpdatePreference[]
}

/// Friends-and-family TestFlight usage telemetry (client + server auth events).
model BetaUsageEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  props     Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([name, createdAt])
}

/// Pursuit (`Goal`) lifecycle + reused on `ThemeCategory` / timeline derivation.
enum PursuitStatus {
  ACTIVE
  PAUSED
  COMPLETE
  MAINTAINING
}

/// Lived status transitions only — the map records what it witnessed.
/// Birth statuses, authoring-window corrections, and short-window flips are
/// never rows (rules: src/lib/pursuit/status-transition-planner.ts).
model PursuitStatusTransition {
  id         String        @id @default(cuid())
  userId     String
  goalId     String
  goal       Goal          @relation(fields: [goalId], references: [id], onDelete: Cascade)
  fromStatus PursuitStatus
  toStatus   PursuitStatus
  at         DateTime      @default(now())

  @@index([goalId, at])
  @@index([userId, at])
}

enum BranchStatus {
  active
  paused
  achieved
  abandoned
}

enum ProfileFactCategory {
  personal
  career
  financial
  health
  relationships
  preferences
  strengths
}

enum ProfileFactSource {
  user_manual
}

enum AiReadingDirtyEntityType {
  pursuit
  theme
  global
}

enum PursuitContextEntryKind {
  clarifier_answer
  manual_edit
  create
  ai_merge
}

enum PursuitRelationshipKind {
  related
}

enum ImportContentType {
  TEXT
  URL
  PHOTO
  VOICE
  MIXED
}

enum ImportCaptureDisposition {
  PRIMARY
  DUPLICATE_IGNORED
  DUPLICATE_RETAINED
}

enum AlmanacImportScope {
  CHAT
  PROJECT
  BOOTSTRAP
}

enum AlmanacUpdateState {
  NOW
  NEXT
  OPEN
  DONE
}

enum ImportSourceState {
  RECEIVED
  STORED
  PROCESSING
  PROCESSED
  AWAITING_REVIEW
  PARTIALLY_APPLIED
  APPLIED
  DISMISSED
  FAILED
  DELETED
}

enum ImportJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ImportJobStage {
  NORMALIZE
  DEDUPLICATE
  SEGMENT
  EXTRACT
  RECONCILE
  PROPOSE
}

enum ImportSegmentStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum LifeObservationKind {
  FACT
  EVENT
  ASPIRATION
  DECISION
  COMMITMENT
  POSSIBILITY
  TENSION
  OPEN_QUESTION
  PREFERENCE
  CONTEXT
  INTERPRETATION
  ADVICE
}

enum LifeObservationStatus {
  ACTIVE
  SUPERSEDED
  RESOLVED
  DISMISSED
}

enum LifeSubjectType {
  USER
  OTHER_PERSON
  SHARED
  UNKNOWN
}

enum LifeMemoryDestination {
  CHAPTER
  BACKGROUND
  POSSIBILITY
  SOURCE_ONLY
}

enum LifeBackgroundCategory {
  IDENTITY
  PEOPLE
  PLACES
  WORK_QUALIFICATIONS
  ASSETS_FINANCES
  HEALTH
  PREFERENCES_CONSTRAINTS
  OTHER
}

enum LifeTemporalState {
  PAST
  CURRENT
  ONGOING
  PLANNED
  POSSIBLE
  UNRESOLVED
  UNKNOWN
}

enum LifeTemporalPrecision {
  EXACT
  APPROXIMATE
  RANGE
  ONGOING
  UNKNOWN
}

enum SourceSupportType {
  EXPLICIT
  INFERRED
  USER_CONFIRMED
}

enum ObservationEvidenceRole {
  SUPPORTS
  CONTRADICTS
}

enum ChapterObservationRole {
  PRIMARY
  RELATED
}

enum ImportProposalKind {
  NEW_OBSERVATION
  REINFORCEMENT
  UPDATE
  CONFLICT
  POSSIBLE_CONNECTION
  NEW_CHAPTER
}

enum ImportProposalStatus {
  PENDING
  ACCEPTED
  DISMISSED
  DEFERRED
  SUPERSEDED
}

enum ChapterRevisionKind {
  CREATED
  UPDATED
  DECISION
  COMMITMENT
  TENSION
  TIMING
  STATUS
  CONNECTION
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ThemeCategory {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Life area id (`finance` | `work` | `becoming` | `people` | `health` | `pleasures`).
  themeId          String
  label            String?
  mapAngleOffset   Float         @default(0)
  goals            Goal[]
  status           BranchStatus  @default(active)
  order            Int           @default(0)
  /// Progressive reveal: visible on tree/roadmap when true.
  isActive         Boolean       @default(false)
  /// Locked taxonomy category (one of 22); protected from wipe scripts.
  isSystemCategory Boolean       @default(false)
  lifecycleStatus  PursuitStatus @default(ACTIVE)
  completedAt      DateTime?
  endedAt          DateTime?
  endReason        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId])
  @@index([userId, themeId])
  @@index([userId, isActive])
}

model ProfileFact {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   ProfileFactCategory
  key        String
  value      String
  confidence Float?
  source     ProfileFactSource   @default(user_manual)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([userId, category, key])
  @@index([userId, category])
}

model UserManualProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName       String?
  dateOfBirth       DateTime?
  location          String?
  languages         String[]
  occupation        String?
  educationLevel    String?
  employmentStatus  String?
  industry          String?
  jobTitle          String?
  /// ISO 4217 currency code for formatting finance amounts (e.g. GBP, USD, EUR).
  currencyCode      String?
  /// metric | imperial — display preference for weight/distance metrics.
  measurementSystem String?
  updatedAt         DateTime  @updatedAt
  createdAt         DateTime  @default(now())
}

/// AI-observed personal context (WHO). Separate from map data (WHAT).
model UserMemory {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Structured prose summary (~250 words) for formatUserContext.
  blob             String    @db.Text
  version          Int       @default(1)
  isDirty          Boolean   @default(false)
  lastUserEditedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
}

model UserMemoryHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blob      String   @db.Text
  version   Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Cached AI insights for Reading tab + theme/pursuit detail panels.
model InsightCache {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  globalInsight    String   @db.Text
  themeInsights    Json
  /// Category-tier insight JSON. SQL column retains legacy name until optional tail rename.
  categoryInsights Json     @map("hubInsights")
  pursuitInsights  Json
  /// AI-authored whole-map reading hero (oneLiner + support) for Reading tab OVERALL card.
  overallInsight   Json?
  generatedAt      DateTime @default(now())
  /// Hash of pursuit/milestone counts + latest updatedAt; invalidates cache when map changes.
  mapVersion       String
  /// From UserMemory.version when Phase B exists; 0 until then.
  memoryVersion    Int      @default(0)
  updatedAt        DateTime @updatedAt
}

/// Tracks map entities that changed since the last successful AI reading sync.
model AiReadingDirtyItem {
  id         String                   @id @default(cuid())
  userId     String
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType AiReadingDirtyEntityType
  entityId   String
  reason     String
  details    Json?
  createdAt  DateTime                 @default(now())

  @@unique([userId, entityType, entityId])
  @@index([userId, createdAt])
}

model Goal {
  id                     String                     @id @default(cuid())
  title                  String
  /// AI-generated compact label for map canvas SVG only (never panel/roadmap/timeline).
  shortLabel             String?
  /// Lucide kebab-case slug for pursuit hex icon (e.g. "dumbbell"). Null → theme icon at render.
  iconName               String?
  description            String
  /// User-authored background prose — AI reads, never writes. Physical column rename deferred post-TestFlight.
  background             String?                    @map("rationale")
  /// Structured clarifier answers from pursuit enrich ({ clarifierId, prompt, selectedOption }[]).
  enrichAnswers          Json?
  lifeArea               String                     @default("Other")
  goalType               String                     @default("action")
  targetAmount           Float?
  currentAmount          Float?
  unit                   String?
  /// gross | net — how currentAmount should be read (flow income pursuits).
  amountBasis            String?
  deadline               DateTime?
  /// Swimlane / timeline span start; when null the UI uses {@link createdAt}.
  timelineStart          DateTime?
  aiGenerated            Boolean                    @default(true)
  archived               Boolean                    @default(false)
  status                 PursuitStatus              @default(ACTIVE)
  completedAt            DateTime?
  endedAt                DateTime?
  endReason              String?
  parentGoalId           String?
  parentGoal             Goal?                      @relation("GoalFork", fields: [parentGoalId], references: [id], onDelete: SetNull)
  forkedGoals            Goal[]                     @relation("GoalFork")
  createdFromGoalId      String?
  createdFromGoal        Goal?                      @relation("SuggestAddProvenance", fields: [createdFromGoalId], references: [id], onDelete: SetNull)
  suggestedGoals         Goal[]                     @relation("SuggestAddProvenance")
  year                   Int                        @default(2026)
  month                  Int?
  /// Explicit linear order along the parent category line (mobile reorganize fallback).
  sequencePosition       Float?
  /// Mobile map world-grid axial q — when set, layout pins this pursuit to the cell.
  mapGridQ               Int?
  /// Mobile map world-grid axial r — when set, layout pins this pursuit to the cell.
  mapGridR               Int?
  /// User-set importance 1–3; null = unset (map renders neutral size).
  significance           Int?
  future                 Boolean                    @default(false)
  isTurningPoint         Boolean                    @default(false)
  location               String?
  timelineNote           String?
  subtype                String?
  /// Universal chapter archetype id (e.g. employment_role). Null = Custom Chapter.
  chapterType            String?
  /// Structured identity facts for typed chapters (JSON object of string keys → string values).
  identityFacts          Json?
  /// Short statement of what matters now within this chapter (≤140 chars in API).
  currentFocus           String?
  themeId                String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  userId                 String
  user                   User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId             String?
  themeCategory          ThemeCategory?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  milestones             Milestone[]
  contextEntries         PursuitContextEntry[]
  relationshipsAsA       PursuitRelationship[]      @relation("RelationshipGoalA")
  relationshipsAsB       PursuitRelationship[]      @relation("RelationshipGoalB")
  statusTransitions      PursuitStatusTransition[]
  observations           ChapterObservation[]
  importProposals        ImportProposal[]           @relation("ProposalTargetGoal")
  relatedImportProposals ImportProposal[]           @relation("ProposalRelatedGoal")
  chapterRevisions       ChapterRevision[]
  livingTreeMembership   LivingTreeGroupMembership?
  atlasPlacement         AtlasPlacement?

  @@unique([id, userId])
  @@index([parentGoalId])
  @@index([createdFromGoalId])
  @@index([categoryId])
  @@index([themeId])
  @@index([archived])
  @@index([categoryId, sequencePosition])
}

/// Append-only pursuit context log — source of truth for user-stated context.
model PursuitContextEntry {
  id        String                  @id @default(cuid())
  userId    String
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId    String
  goal      Goal                    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  kind      PursuitContextEntryKind
  text      String
  metadata  Json?
  createdAt DateTime                @default(now())

  @@index([goalId, createdAt])
  @@index([userId, createdAt])
}

/// User-confirmed lateral relationship between two pursuits (peers, not trees).
model PursuitRelationship {
  id                String                  @id @default(cuid())
  userId            String
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalAId           String
  goalA             Goal                    @relation("RelationshipGoalA", fields: [goalAId], references: [id], onDelete: Cascade)
  goalBId           String
  goalB             Goal                    @relation("RelationshipGoalB", fields: [goalBId], references: [id], onDelete: Cascade)
  kind              PursuitRelationshipKind @default(related)
  label             String?
  sourceClarifierId String?
  confirmedAt       DateTime                @default(now())
  createdAt         DateTime                @default(now())

  @@unique([userId, goalAId, goalBId])
  @@index([userId])
  @@index([goalAId])
  @@index([goalBId])
}

model Milestone {
  id          String    @id @default(cuid())
  title       String
  description String
  position    Int
  completedAt DateTime?
  dueDate     DateTime?
  goalId      String
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, position])
}

/// Immutable source selected by the user for Almanac to interpret.
/// Derived records reference fragments; processing never rewrites rawText.
model ImportSource {
  id              String                 @id @default(cuid())
  userId          String
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientImportId  String
  contentType     ImportContentType
  contentHash     String
  rawText         String
  characterCount  Int
  title           String?
  sourceUrl       String?
  sourceApp       String?
  metadata        Json?
  capturedAt      DateTime?
  state           ImportSourceState      @default(RECEIVED)
  duplicateOfId   String?
  duplicateOf     ImportSource?          @relation("ImportSourceDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates      ImportSource[]         @relation("ImportSourceDuplicate")
  deletedAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  fragments       SourceFragment[]
  evidenceSpans   SourceEvidenceSpan[]
  proposals       ImportProposal[]
  jobs            ImportJob[]
  captureReceipts ImportCaptureReceipt[]

  @@unique([userId, clientImportId])
  @@unique([id, userId])
  @@index([userId, contentHash])
  @@index([userId, state, createdAt])
  @@index([duplicateOfId])
}

/// One user-initiated arrival of canonical source content. Receipt metadata is
/// preserved even when several captures point to the same ImportSource.
model ImportCaptureReceipt {
  id             String                   @id @default(cuid())
  userId         String
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId       String
  source         ImportSource             @relation(fields: [sourceId, userId], references: [id, userId], onDelete: Cascade)
  clientImportId String
  disposition    ImportCaptureDisposition @default(PRIMARY)
  title          String?
  sourceUrl      String?
  sourceApp      String?
  metadata       Json?
  capturedAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([userId, clientImportId])
  @@index([sourceId, deletedAt, createdAt])
  @@index([userId, deletedAt, createdAt])
}

/// Exact bounded passage from an ImportSource. Offsets refer to rawText.
model SourceFragment {
  id               String                     @id @default(cuid())
  sourceId         String
  source           ImportSource               @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  position         Int
  startOffset      Int
  endOffset        Int
  contentHash      String
  text             String
  createdAt        DateTime                   @default(now())
  evidence         ObservationEvidence[]
  proposals        ImportProposal[]
  revisionEvidence ChapterRevisionEvidence[]
  corrections      InterpretationCorrection[]
  segmentRuns      ImportSegmentRun[]
  evidenceSpans    SourceEvidenceSpan[]

  @@unique([sourceId, position])
  @@index([sourceId, contentHash])
}

/// Exact atomic citation within an immutable source. SourceFragment remains
/// the bounded processing segment; this model is the user-visible evidence.
model SourceEvidenceSpan {
  id               String                        @id @default(cuid())
  sourceId         String
  source           ImportSource                  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  segmentId        String?
  segment          SourceFragment?               @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  startOffset      Int
  endOffset        Int
  contentHash      String
  text             String
  createdAt        DateTime                      @default(now())
  proposalLinks    ImportProposalEvidence[]
  observationLinks ObservationEvidenceSpan[]
  revisionLinks    ChapterRevisionEvidenceSpan[]

  @@unique([sourceId, startOffset, endOffset])
  @@index([segmentId])
  @@index([sourceId, contentHash])
}

/// Consolidated meaning confirmed by the user and supported by source fragments.
model LifeObservation {
  id                      String                      @id @default(cuid())
  userId                  String
  user                    User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind                    LifeObservationKind
  status                  LifeObservationStatus       @default(ACTIVE)
  subjectType             LifeSubjectType             @default(USER)
  subjectLabel            String?
  memoryDestination       LifeMemoryDestination       @default(BACKGROUND)
  backgroundCategory      LifeBackgroundCategory?
  temporalState           LifeTemporalState           @default(UNKNOWN)
  temporalPrecision       LifeTemporalPrecision       @default(UNKNOWN)
  canonicalKey            String?
  canonicalText           String
  supersedesObservationId String?
  supersedesObservation   LifeObservation?            @relation("ObservationSupersession", fields: [supersedesObservationId], references: [id], onDelete: SetNull)
  supersededBy            LifeObservation[]           @relation("ObservationSupersession")
  occurredAt              DateTime?
  effectiveFrom           DateTime?
  effectiveTo             DateTime?
  firstObservedAt         DateTime?
  lastMentionedAt         DateTime?
  lastConfirmedAt         DateTime?
  confirmedAt             DateTime                    @default(now())
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  evidence                ObservationEvidence[]
  exactEvidence           ObservationEvidenceSpan[]
  chapters                ChapterObservation[]
  proposals               ImportProposal[]
  targetedApplications    ImportProposalApplication[] @relation("ApplicationTargetObservation")
  resultApplications      ImportProposalApplication[] @relation("ApplicationResultObservation")

  @@index([userId, status, updatedAt])
  @@index([userId, kind])
  @@index([userId, memoryDestination, status])
  @@index([userId, canonicalKey, status])
  @@index([supersedesObservationId])
}

/// Provenance between consolidated meaning and exact source fragments.
model ObservationEvidence {
  observationId String
  observation   LifeObservation         @relation(fields: [observationId], references: [id], onDelete: Cascade)
  fragmentId    String
  fragment      SourceFragment          @relation(fields: [fragmentId], references: [id], onDelete: Cascade)
  role          ObservationEvidenceRole @default(SUPPORTS)
  createdAt     DateTime                @default(now())

  @@id([observationId, fragmentId])
  @@index([fragmentId])
}

/// One observation can inform several chapters without duplicating source text.
model ChapterObservation {
  userId        String
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId        String
  goal          Goal                   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  observationId String
  observation   LifeObservation        @relation(fields: [observationId], references: [id], onDelete: Cascade)
  role          ChapterObservationRole @default(PRIMARY)
  createdAt     DateTime               @default(now())

  @@id([goalId, observationId])
  @@index([userId, createdAt])
  @@index([observationId])
}

/// Reversible AI suggestion. It has no authority until accepted by the user.
model ImportProposal {
  id                 String                     @id @default(cuid())
  userId             String
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId           String
  source             ImportSource               @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  fragmentId         String?
  fragment           SourceFragment?            @relation(fields: [fragmentId], references: [id], onDelete: SetNull)
  observationId      String?
  observation        LifeObservation?           @relation(fields: [observationId], references: [id], onDelete: SetNull)
  targetGoalId       String?
  targetGoal         Goal?                      @relation("ProposalTargetGoal", fields: [targetGoalId], references: [id], onDelete: SetNull)
  relatedGoalId      String?
  relatedGoal        Goal?                      @relation("ProposalRelatedGoal", fields: [relatedGoalId], references: [id], onDelete: SetNull)
  kind               ImportProposalKind
  status             ImportProposalStatus       @default(PENDING)
  informationType    LifeObservationKind        @default(CONTEXT)
  subjectType        LifeSubjectType            @default(USER)
  subjectLabel       String?
  memoryDestination  LifeMemoryDestination      @default(BACKGROUND)
  backgroundCategory LifeBackgroundCategory?
  temporalState      LifeTemporalState          @default(UNKNOWN)
  temporalPrecision  LifeTemporalPrecision      @default(UNKNOWN)
  observedAt         DateTime?
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  confidence         Float?
  canonicalKey       String?
  processingKey      String
  proposedText       String
  rationale          String?
  payload            Json?
  reviewedAt         DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  chapterRevision    ChapterRevision?
  corrections        InterpretationCorrection[]
  exactEvidence      ImportProposalEvidence[]
  application        ImportProposalApplication?

  @@unique([sourceId, processingKey])
  @@index([userId, status, createdAt])
  @@index([userId, status, memoryDestination])
  @@index([sourceId, status])
  @@index([fragmentId])
  @@index([observationId])
  @@index([targetGoalId])
  @@index([relatedGoalId])
}

/// Reversible, user-confirmed application of one proposal. The result remains
/// inspectable after undo; undo changes observation status instead of erasing history.
model ImportProposalApplication {
  id                     String                       @id @default(cuid())
  userId                 String
  user                   User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposalId             String                       @unique
  proposal               ImportProposal               @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  targetObservationId    String?
  targetObservation      LifeObservation?             @relation("ApplicationTargetObservation", fields: [targetObservationId], references: [id], onDelete: SetNull)
  resultObservationId    String?                      @unique
  resultObservation      LifeObservation?             @relation("ApplicationResultObservation", fields: [resultObservationId], references: [id], onDelete: SetNull)
  priorTargetStatus      LifeObservationStatus?
  priorTargetEffectiveTo DateTime?
  appliedAt              DateTime                     @default(now())
  revertedAt             DateTime?
  livingTreeEffect       LivingTreeApplicationEffect?

  @@index([userId, appliedAt])
  @@index([targetObservationId])
}

/// Exact evidence attached to a reversible proposal. The older fragmentId on
/// ImportProposal remains as a processing-segment compatibility pointer.
model ImportProposalEvidence {
  proposalId     String
  proposal       ImportProposal          @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  evidenceSpanId String
  evidenceSpan   SourceEvidenceSpan      @relation(fields: [evidenceSpanId], references: [id], onDelete: Cascade)
  role           ObservationEvidenceRole @default(SUPPORTS)
  supportType    SourceSupportType       @default(EXPLICIT)
  createdAt      DateTime                @default(now())

  @@id([proposalId, evidenceSpanId, role])
  @@index([evidenceSpanId])
}

/// Exact citations for accepted observations. The legacy fragment evidence is
/// retained until the V2 apply path is proven and migrated.
model ObservationEvidenceSpan {
  observationId  String
  observation    LifeObservation         @relation(fields: [observationId], references: [id], onDelete: Cascade)
  evidenceSpanId String
  evidenceSpan   SourceEvidenceSpan      @relation(fields: [evidenceSpanId], references: [id], onDelete: Cascade)
  role           ObservationEvidenceRole @default(SUPPORTS)
  supportType    SourceSupportType       @default(EXPLICIT)
  createdAt      DateTime                @default(now())

  @@id([observationId, evidenceSpanId, role])
  @@index([evidenceSpanId])
}

/// User-confirmed, inspectable change in a chapter's history.
model ChapterRevision {
  id            String                        @id @default(cuid())
  userId        String
  user          User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId        String
  goal          Goal                          @relation(fields: [goalId], references: [id], onDelete: Cascade)
  proposalId    String?                       @unique
  proposal      ImportProposal?               @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  kind          ChapterRevisionKind
  summary       String
  beforeState   Json?
  afterState    Json
  occurredAt    DateTime?
  confirmedAt   DateTime                      @default(now())
  createdAt     DateTime                      @default(now())
  evidence      ChapterRevisionEvidence[]
  exactEvidence ChapterRevisionEvidenceSpan[]

  @@index([goalId, confirmedAt])
  @@index([userId, confirmedAt])
}

model ChapterRevisionEvidence {
  revisionId String
  revision   ChapterRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  fragmentId String
  fragment   SourceFragment  @relation(fields: [fragmentId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@id([revisionId, fragmentId])
  @@index([fragmentId])
}

model ChapterRevisionEvidenceSpan {
  revisionId     String
  revision       ChapterRevision    @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  evidenceSpanId String
  evidenceSpan   SourceEvidenceSpan @relation(fields: [evidenceSpanId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())

  @@id([revisionId, evidenceSpanId])
  @@index([evidenceSpanId])
}

/// User correction of a proposed interpretation; retained separately from the source.
model InterpretationCorrection {
  id                      String          @id @default(cuid())
  userId                  String
  user                    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposalId              String?
  proposal                ImportProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  fragmentId              String?
  fragment                SourceFragment? @relation(fields: [fragmentId], references: [id], onDelete: SetNull)
  originalInterpretation  Json
  correctedInterpretation Json
  createdAt               DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([proposalId])
  @@index([fragmentId])
}

/// Durable processing run; safe errors only (never source bodies in error fields).
model ImportJob {
  id                String             @id @default(cuid())
  sourceId          String
  source            ImportSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  runKey            String
  status            ImportJobStatus    @default(PENDING)
  stage             ImportJobStage     @default(NORMALIZE)
  attempt           Int                @default(0)
  processingVersion String
  errorCode         String?
  errorDetail       String?
  nextRetryAt       DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  segments          ImportSegmentRun[]

  @@unique([sourceId, runKey])
  @@index([status, nextRetryAt])
}

/// Per-fragment processing state allows partial success and safe resume.
model ImportSegmentRun {
  id          String              @id @default(cuid())
  jobId       String
  job         ImportJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fragmentId  String
  fragment    SourceFragment      @relation(fields: [fragmentId], references: [id], onDelete: Cascade)
  position    Int
  status      ImportSegmentStatus @default(PENDING)
  attempt     Int                 @default(0)
  result      Json?
  errorCode   String?
  nextRetryAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([jobId, fragmentId])
  @@index([jobId, status, position])
  @@index([status, nextRetryAt])
}

enum LivingTreeGroupOrigin {
  BOOTSTRAP
  ACCEPTED_CHAPTER
}

/// Persisted Living Tree projection configuration. A group organises how the
/// confirmed model is displayed; it is not a life fact, chapter, theme or
/// relationship, and it never carries meaning of its own.
///
/// Slot range, archive/slot exclusivity and one-group-per-visible-slot are
/// enforced by database constraints declared in the migration, not by Prisma.
model LivingTreeGroup {
  id         String                @id @default(cuid())
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// User-confirmed and editable. AI may propose it; only confirmation stores it.
  name       String
  /// 1..5 while visible on the tree. Null means All chapters, or archived.
  slot       Int?
  /// Slot held at archive time so Undo can restore the same position.
  lastSlot   Int?
  archivedAt DateTime?
  /// Per-group optimistic concurrency. Bumped on every write to this group.
  version    Int                   @default(1)
  origin     LivingTreeGroupOrigin
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  memberships       LivingTreeGroupMembership[]
  effectsAsGroup    LivingTreeApplicationEffect[] @relation("EffectGroup")
  effectsAsPromoted LivingTreeApplicationEffect[] @relation("EffectPromotedGroup")

  @@index([userId, archivedAt])
}

/// At most one primary group per chapter. The primary key is the cardinality
/// proof and an absent row means the chapter is ungrouped and lives in All
/// chapters.
///
/// Deliberately carries no userId: ownership derives from the chapter, so an
/// account merge moves nothing here and cannot strand or mis-own a row. A
/// database trigger rejects a membership whose chapter and group have different
/// owners.
model LivingTreeGroupMembership {
  goalId      String          @id
  goal        Goal            @relation(fields: [goalId], references: [id], onDelete: Cascade)
  groupId     String
  group       LivingTreeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  confirmedAt DateTime        @default(now())

  @@index([groupId])
}

/// Stable, non-semantic placement of one Chapter on the Personal Atlas.
/// Slot geography never encodes theme, status, importance, time or relationship.
/// Hiding a Chapter keeps this row so restore returns it to the same position.
model AtlasPlacement {
  goalId    String    @id
  userId    String
  goal      Goal      @relation(fields: [goalId, userId], references: [id, userId], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot      Int
  hiddenAt  DateTime?
  focusedAt DateTime?
  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, slot])
  @@unique([goalId, userId])
  @@index([userId, hiddenAt])
}

/// Immutable provenance for one user-reviewed ALMANAC/1 packet. Only undoneAt
/// may change after commit; the database migration enforces that boundary.
model AlmanacImport {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  idempotencyKey  String
  protocolVersion String             @default("ALMANAC/1")
  scope           AlmanacImportScope
  rawPacket       String
  receipt         Json
  createdAt       DateTime           @default(now())
  undoneAt        DateTime?
  updates         AlmanacUpdate[]

  @@unique([userId, idempotencyKey])
  @@unique([id, userId])
  @@index([userId, createdAt])
}

/// Stable storage row for a user-facing Subject. `slot` is a deployed
/// compatibility sequence only; it has no spatial, ordering or capacity meaning.
model AlmanacPlace {
  id                       String                     @id @default(cuid())
  userId                   String
  user                     User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                     String
  normalisedName           String
  slot                     Int
  createdAt                DateTime                   @default(now())
  updates                  AlmanacUpdate[]
  subjectPreference        AlmanacSubjectPreference?  @relation("AlmanacSubjectPreferenceSource")
  mergedSubjectPreferences AlmanacSubjectPreference[] @relation("AlmanacSubjectPreferenceTarget")

  @@unique([userId, normalisedName])
  @@unique([userId, slot])
  @@unique([id, userId])
}

/// Mutable owner-scoped presentation for one user-facing Subject. This is
/// deliberately separate from append-only Places, Updates and original
/// responses so rename, icon, archive and reversible merge never rewrite
/// accepted history.
model AlmanacSubjectPreference {
  placeId           String        @id
  userId            String
  place             AlmanacPlace  @relation("AlmanacSubjectPreferenceSource", fields: [placeId, userId], references: [id, userId], onDelete: Cascade)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName       String?
  iconKey           String?
  archivedAt        DateTime?
  mergedIntoPlaceId String?
  mergedIntoPlace   AlmanacPlace? @relation("AlmanacSubjectPreferenceTarget", fields: [mergedIntoPlaceId, userId], references: [id, userId], onDelete: NoAction)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([placeId, userId])
  @@index([userId, archivedAt])
  @@index([mergedIntoPlaceId, userId])
}

/// One accepted ALMANAC/1 line. Updates are append-only; a newer row may point
/// to the older row it explicitly supersedes without rewriting either history.
model AlmanacUpdate {
  id                    String                   @id @default(cuid())
  userId                String
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  importId              String
  import                AlmanacImport            @relation(fields: [importId, userId], references: [id, userId], onDelete: Cascade)
  placeId               String
  place                 AlmanacPlace             @relation(fields: [placeId, userId], references: [id, userId], onDelete: Cascade)
  state                 AlmanacUpdateState
  text                  String
  normalisedFingerprint String
  sourceLineNumber      Int
  supersedesUpdateId    String?
  supersedesUpdate      AlmanacUpdate?           @relation("AlmanacUpdateSupersession", fields: [supersedesUpdateId, userId], references: [id, userId], onDelete: NoAction)
  supersededBy          AlmanacUpdate[]          @relation("AlmanacUpdateSupersession")
  visibilityPreference  AlmanacUpdatePreference?
  createdAt             DateTime                 @default(now())

  @@unique([importId, sourceLineNumber])
  @@unique([id, userId])
  @@index([userId, placeId, state, createdAt])
  @@index([userId, importId])
  @@index([userId, supersedesUpdateId])
}

/// Mutable owner-scoped visibility for an accepted Update. Hiding an Update
/// never edits the accepted statement or its immutable original response.
model AlmanacUpdatePreference {
  updateId  String        @id
  userId    String
  update    AlmanacUpdate @relation(fields: [updateId, userId], references: [id, userId], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  hiddenAt  DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([updateId, userId])
  @@index([userId, hiddenAt])
}

/// Projection-side record of what one applied proposal did to the tree, so Undo
/// and reapply replay exact prior state instead of reconstructing it. Held apart
/// from ImportProposalApplication because a group is projection configuration,
/// not confirmed life meaning.
model LivingTreeApplicationEffect {
  applicationId       String                    @id
  application         ImportProposalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// Group the accepted chapter joined.
  groupId             String
  group               LivingTreeGroup           @relation("EffectGroup", fields: [groupId], references: [id], onDelete: Cascade)
  /// True when this application created the group rather than joining one.
  groupCreated        Boolean                   @default(false)
  groupSlotAtApply    Int?
  /// Written when Undo empties and archives the group.
  groupArchivedOnUndo Boolean                   @default(false)
  groupLastSlotOnUndo Int?
  /// Group promoted into the slot Undo freed, so reapply can demote it again.
  promotedGroupId     String?
  promotedGroup       LivingTreeGroup?          @relation("EffectPromotedGroup", fields: [promotedGroupId], references: [id], onDelete: SetNull)
  promotedToSlot      Int?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([groupId])
}

{
  "name": "pathfinder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3001",
    "dev:3000": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:free": "npx --yes kill-port@2.0.1 3001 && next dev --hostname 0.0.0.0 --port 3001",
    "dev:fresh": "node -e \"try{require('fs').rmSync('.next',{recursive:true})}catch(e){}\" && npx --yes kill-port@2.0.1 3001 && next dev --hostname 0.0.0.0 --port 3001",
    "dev:free3000": "npx --yes kill-port@2.0.1 3000 && next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "checkpoint": "git add -A && git commit -m \"checkpoint: $(date '+%Y-%m-%d %H:%M:%S')\"",
    "checkpoint-msg": "git add -A && git commit -m",
    "undo": "git reset --hard HEAD~1",
    "snapshot": "npx ts-node scripts/snapshot.ts",
    "migrate:moments": "npx tsx scripts/migrate-moments-to-marks.ts",
    "seed:tree": "npx tsx scripts/seed-tree-test.ts",
    "clear-goals": "npx tsx scripts/clear-all-goals.ts",
    "backfill:tree-milestones": "npx tsx scripts/backfill-tree-milestones-to-relational.ts",
    "backfill:goal-bloom": "npx tsx scripts/backfill-goal-bloom.ts",
    "diagnose:milestone-recompute": "npx tsx scripts/diagnose-milestone-recompute.ts",
    "backfill:rename-legacy-subtasks": "npx tsx scripts/backfill-rename-legacy-subtask-titles.ts",
    "backfill:delete-scaffolding-subtasks": "npx tsx scripts/backfill-delete-scaffolding-subtasks.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "groq-sdk": "^1.1.2",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "mammoth": "^1.12.0",
    "next": "16.2.4",
    "next-auth": "^4.24.14",
    "pdf-parse": "^2.4.5",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^12.9.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "playwright": "^1.59.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
